#%PAM-1.0
# reclogin's automatic login. NO PASSWORD: the auth line below accepts
# anyone. Only reclogin may start this service, and only the session worker's
# automatic login does (src/bin/reclogind/autologin.rs): for the one account
# named in /etc/reclogin.conf (`autologin`), at the start of reclogind, once
# per boot, after the worker checked that the account is on the user list and
# is not root. The worker has no conversation here and refuses any question.
# Nothing else may name this service (a program that took it as its own PAM
# service would need no password).
#
# Installed as /etc/pam.d/reclogin-autologin on LevitateOS. The account and
# session lines are those of /etc/pam.d/reclogin (dist/pam/reclogin.levitateos),
# so a locked account, an expired one or one outside its allowed times is
# refused as in a normal login; the auth lines of the password login (system-
# auth, the desktop wallets that need the password) are the only ones left out.
auth       required     pam_permit.so
account    required     pam_nologin.so
account    include      system-auth
password   required     pam_deny.so
# pam_selinux.so close should be the first session rule
session    required     pam_selinux.so close
session    required     pam_loginuid.so
# pam_selinux.so open should only be followed by sessions to be executed in the user context
session    required     pam_selinux.so open
session    required     pam_namespace.so
session    optional     pam_keyinit.so force revoke
session    include      system-auth
-session   optional     pam_kwallet5.so auto_start
-session   optional     pam_gnome_keyring.so auto_start
session    include      postlogin
-session   optional     pam_ck_connector.so
